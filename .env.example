# Database (required)
MONGODB_URL=

# Authentication (required)
JWT_SECRET=

# Server
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Google Gemini AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Redis and BullMQ (required for catering background jobs)
REDIS_URI=redis://127.0.0.1:6379

# SMTP email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NXT_RAIL Support <support@nxtrail.com>